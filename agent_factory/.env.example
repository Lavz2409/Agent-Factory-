# AWS credentials (real deployment)
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here
# Primary region for Bedrock, DynamoDB, SQS (use this; must match your resources)
AWS_REGION=us-east-1
# Fallback if AWS_REGION is unset (boto3 / AWS CLI convention)
AWS_DEFAULT_REGION=us-east-1

# Bedrock model IDs
# Text generation — Amazon Nova Lite (use region prefix: us., eu., etc. — see AWS model IDs)
# Alternatives: anthropic.claude-3-haiku-20240307-v1:0, anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REASONING_MODEL=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v1
BEDROCK_COST_MODEL=meta.llama2-13b-chat-v1
# Inference temperature (Claude / Titan / Llama in BedrockRealClient)
BEDROCK_TEMPERATURE=0.2

# SQS queues (real deployment)
SQS_PLANNER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123/planner-queue
SQS_WORKER_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123/worker-queue
SQS_OUTPUT_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123/output-queue
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123/dead-letter-queue

# DynamoDB table (partition key: run_id, string)
DYNAMODB_TABLE=agent-factory-state
# Legacy alias — ignored if DYNAMODB_TABLE is set
# DYNAMODB_STATE_TABLE=agent-factory-state

# S3 bucket
S3_INPUT_BUCKET=agent-factory-inputs
S3_OUTPUT_BUCKET=agent-factory-outputs

# Bedrock Knowledge Base (RAG)
BEDROCK_KB_ID=your-knowledge-base-id

# Local development flag — set true to run without real AWS
LOCAL_MODE=true
